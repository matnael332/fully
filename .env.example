# Local development only. Copy to .env and replace placeholder passwords.
# .env is ignored by Git.

# Schema owner / administrative role. Used for migrations and system maintenance only.
POSTGRES_USER=workcontinuity
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=workcontinuity
POSTGRES_PORT=5432

# Application runtime role. Deliberately NOT the schema owner and not a superuser, because
# PostgreSQL row-level security is bypassed by superusers and by an unforced table owner.
# Created on first database initialization by infra/local/postgres/init/10-runtime-role.sh.
POSTGRES_APP_USER=workcontinuity_app
POSTGRES_APP_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_APP_PASSWORD

# Azure Service Bus Emulator depends on SQL Server Linux.
# You must explicitly set ACCEPT_EULA=Y after reviewing Microsoft's license terms.
ACCEPT_EULA=N
MSSQL_SA_PASSWORD=CHANGE_ME_LOCAL_MSSQL_PASSWORD_123!
SERVICEBUS_AMQP_PORT=5672
EMULATOR_HTTP_PORT=5300

WEB_HTTP_PORT=8080
